[Unit]
Description=RESET Pear gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=reset
Group=reset
WorkingDirectory=/opt/reset/current
ExecStart=/opt/reset/node/bin/node /opt/reset/current/scripts/pear-runner.mjs --role gateway --config /etc/reset/gateway.json --gateway 1
Environment=NODE_ENV=production
Environment=MAYHEM_INTERCOM_LEGACY_PEAR_RUN=0
Environment=PEAR_RUNNER_STDIN=0
Environment=HOME=/srv/reset/gateway/pear
Environment=XDG_CONFIG_HOME=/srv/reset/gateway/pear/config
Environment=XDG_DATA_HOME=/srv/reset/gateway/pear/data
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
KillMode=mixed
SuccessExitStatus=143
MemoryMax=2G
CPUQuota=200%
TasksMax=128
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/srv/reset/gateway
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
